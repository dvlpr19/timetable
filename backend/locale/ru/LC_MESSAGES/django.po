#: apps/solver/messages.py:57
#, python-format
msgid ""
"%(lesson)s: %(teacher)s does not teach in the group's language. Choose "
"another teacher in the workload."
msgstr ""
"%(lesson)s: %(teacher)s не преподаёт на языке группы. Выберите другого "
"преподавателя в нагрузке."

#: apps/solver/messages.py:61
#, python-format
msgid "%(lesson)s: the stream joins groups with different teaching languages."
msgstr "%(lesson)s: в поток объединены группы с разными языками обучения."

#: apps/solver/messages.py:66
#, python-format
msgid ""
"%(lesson)s: no suitable room (%(students)s students, the biggest suitable "
"room has %(biggest)s seats)."
msgstr ""
"%(lesson)s: нет подходящей аудитории (студентов: %(students)s, в самой "
"большой подходящей %(biggest)s мест)."

#: apps/solver/messages.py:75
#, python-format
msgid ""
"%(lesson)s: no free time is left — study days, closed times and the "
"teacher's unavailable times exclude everything."
msgstr ""
"%(lesson)s: свободного времени не осталось — учебные дни, закрытое время и "
"занятость преподавателя исключают всё."

#: apps/solver/messages.py:80
#, python-format
msgid ""
"%(count)s conflicts are among the lessons that stay in place (pinned or "
"outside the chosen scope). The solver works around them but cannot fix them."
msgstr ""
"Среди занятий, которые остаются на месте (закреплённые или вне выбранной "
"области), конфликтов: %(count)s. Программа обходит их, но исправить не "
"может."

#: apps/solver/messages.py:85
#, python-format
msgid ""
"%(teacher)s has %(lessons)s lessons to place but only %(slots)s possible "
"times."
msgstr ""
"У преподавателя %(teacher)s нужно разместить занятий: %(lessons)s, а "
"возможных времён только %(slots)s."

#: apps/solver/messages.py:93
#, python-format
msgid ""
"%(group)s needs %(lessons)s lessons, but the daily limit allows only "
"%(capacity)s."
msgstr ""
"Группе %(group)s нужно занятий: %(lessons)s, а дневной лимит позволяет "
"только %(capacity)s."

#: apps/solver/messages.py:102
#, python-format
msgid "teacher busy: %(n)s"
msgstr "преподаватель занят: %(n)s"

#: apps/solver/messages.py:104
#, python-format
msgid "group busy: %(n)s"
msgstr "группа занята: %(n)s"

#: apps/solver/messages.py:106
#, python-format
msgid "daily limit reached: %(n)s"
msgstr "дневной лимит исчерпан: %(n)s"

#: apps/solver/messages.py:108
#, python-format
msgid "no free room: %(n)s"
msgstr "нет свободной аудитории: %(n)s"

#: apps/solver/messages.py:110
#, python-format
msgid ""
"%(lesson)s: %(missing)s lesson(s) not placed. All %(total)s possible times "
"are taken (%(why)s)."
msgstr ""
"%(lesson)s: не размещено занятий: %(missing)s. Все возможные времена "
"(%(total)s) заняты (%(why)s)."

#: apps/solver/messages.py:120
#, python-format
msgid ""
"%(count)s distance lessons were placed without a link. Add the links in the "
"editor before publishing."
msgstr ""
"Дистанционных занятий без ссылки: %(count)s. Добавьте ссылки в редакторе "
"перед публикацией."

#: apps/solver/messages.py:126
#, python-format
msgid ""
"Each lesson may use the %(n)s smallest rooms that fit it; bigger rooms are "
"kept for bigger lessons."
msgstr ""
"Каждое занятие может занять одну из %(n)s самых маленьких подходящих "
"аудиторий; большие остаются для больших занятий."

#: apps/solver/messages.py:129
msgid "Weekly forms are assumed to share week numbering (week 1 is odd)."
msgstr ""
"Считается, что у недельных форм общая нумерация недель (1-я неделя "
"нечётная)."

#: apps/solver/messages.py:131
msgid ""
"Building moves are reduced by keeping each group in few buildings; the "
"lecture-before-seminar order is scored after the search, not optimised."
msgstr ""
"Переходы между корпусами сокращаются за счёт того, что группа занимается в "
"немногих корпусах; порядок «сначала лекция, потом семинар» оценивается после"
" поиска, а не оптимизируется."

