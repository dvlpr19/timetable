msgstr "Для занятия %(lesson)s не выбрана аудитория."

#: apps/scheduling/validators.py:836
#, python-format
msgid "Online lesson %(lesson)s needs a link."
msgstr "Для онлайн-занятия %(lesson)s не указана ссылка."

#: apps/scheduling/validators.py:838
#, python-format
msgid "Room %(room)s is not in use."
msgstr "Аудитория %(room)s сейчас не используется."

#: apps/scheduling/validators.py:840
#, python-format
msgid "%(when)s is closed for lessons (%(reason)s): %(lesson)s."
msgstr "%(when)s — время закрыто для занятий (%(reason)s): %(lesson)s."

#: apps/scheduling/validators.py:846
#, python-format
msgid "%(when)s is a day off (%(reason)s): %(lesson)s."
msgstr "%(when)s — выходной день (%(reason)s): %(lesson)s."

#: apps/scheduling/validators.py:852
#, python-format
msgid "%(lesson)s is outside the %(form)s timetable (%(when)s)."
msgstr ""
"Занятие %(lesson)s вне расписания формы обучения «%(form)s» (%(when)s)."

#: apps/scheduling/validators.py:858
#, python-format
msgid "%(lesson)s: %(when)s is outside the teaching period."
msgstr "%(lesson)s: %(when)s — вне учебного периода."

#: apps/scheduling/validators.py:863
#, python-format
msgid "%(teacher)s is not available at %(when)s (%(lesson)s)."
msgstr "%(teacher)s не может вести занятия: %(when)s (%(lesson)s)."

#: apps/scheduling/validators.py:870
#, python-format
msgid "%(lesson)s: %(placed)s of %(required)s lessons are placed."
msgstr "%(lesson)s: размещено %(placed)s из %(required)s занятий."

#: apps/scheduling/validators.py:872
#, python-format
msgid "%(lesson)s: %(placed)s lessons are placed, the plan has %(required)s."
msgstr ""
"%(lesson)s: размещено занятий — %(placed)s, а по плану — %(required)s."

#: apps/scheduling/validators.py:880
#, python-format
msgid "%(group)s has %(count)s lessons on %(day)s (at most %(limit)s)."
msgstr ""
"У группы %(group)s слишком много занятий (%(day)s): %(count)s, допустимо не "
"более %(limit)s."

#: apps/scheduling/validators.py:889
#, python-format
