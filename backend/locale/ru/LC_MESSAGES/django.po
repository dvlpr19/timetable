msgid ""
"%(teacher)s has two lessons at the same time (%(when)s): %(a)s and %(b)s."
msgstr "У %(teacher)s два занятия одновременно (%(when)s): %(a)s и %(b)s."

#: apps/scheduling/validators.py:800
#, python-format
msgid ""
"%(group)s has two lessons at the same time (%(when)s): %(a)s and %(b)s."
msgstr ""
"У группы %(group)s два занятия одновременно (%(when)s): %(a)s и %(b)s."

#: apps/scheduling/validators.py:807
#, python-format
msgid "Room %(room)s is taken twice (%(when)s): %(a)s and %(b)s."
msgstr "Аудитория %(room)s занята дважды (%(when)s): %(a)s и %(b)s."

#: apps/scheduling/validators.py:816
#, python-format
msgid ""
"Room %(room)s has %(seats)s seats, but %(lesson)s has %(students)s students."
msgstr ""
"В аудитории %(room)s мест: %(seats)s, а студентов на занятии %(lesson)s: "
"%(students)s."

#: apps/scheduling/validators.py:826
#, python-format
msgid ""
"%(lesson)s needs a room of type “%(required)s”, %(room)s is “%(actual)s”."
msgstr ""
"Для занятия %(lesson)s нужна аудитория типа «%(required)s», а %(room)s — "
"«%(actual)s»."

#: apps/scheduling/validators.py:834
#, python-format
