# Copy to .env and change secrets before any non-local use.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=dars_jadvali
POSTGRES_USER=dars
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Host ports (container ports stay fixed)
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5442

# Web Push (generated in stage 8)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com
