# Copy to .env and change secrets before any non-local use.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=dars_jadvali
POSTGRES_USER=dars
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Demo "today" inside the 2025-2026 spring semester (empty = real date)
DEMO_NOW=2026-04-08

# Host ports (container ports stay fixed)
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5442

# Web Push: python manage.py generate_vapid_keys (empty = push off, in-app messages still work)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com
